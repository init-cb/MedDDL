:root {
  --bg: #f7fafc;
  --surface: #ffffff;
  --surface-soft: #f1f5f9;
  --text: #0f172a;
  --muted: #64748b;
  --line: #e2e8f0;
  --primary: #0f766e;
  --primary-dark: #115e59;
  --primary-soft: #ccfbf1;
  --warning: #b45309;
  --warning-soft: #fef3c7;
  --danger: #b91c1c;
  --danger-soft: #fee2e2;
  --shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
  --radius-xl: 28px;
  --radius-lg: 20px;
  --radius-md: 14px;
  --max-width: 1180px;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: var(--text);
  background:
    radial-gradient(circle at top left, rgba(20, 184, 166, 0.18), transparent 34rem),
    linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
  line-height: 1.6;
}

a { color: inherit; text-decoration: none; }
a:hover { color: var(--primary); }

button, input, select { font: inherit; }

.site-header {
  padding: 24px 20px 44px;
}

.nav-shell, main, .site-footer {
  max-width: var(--max-width);
  margin: 0 auto;
}

.nav-shell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 52px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-weight: 800;
  letter-spacing: -0.03em;
  font-size: 1.2rem;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  border-radius: 14px;
  color: white;
  background: var(--primary);
  box-shadow: 0 12px 24px rgba(15, 118, 110, 0.25);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 16px;
  color: var(--muted);
  font-weight: 600;
  font-size: 0.95rem;
}

.hero {
  max-width: var(--max-width);
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
  gap: 28px;
  align-items: stretch;
}

.hero-copy, .hero-panel, .controls-section, .info-card {
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(226, 232, 240, 0.9);
  box-shadow: var(--shadow);
  backdrop-filter: blur(14px);
}

.hero-copy {
  padding: clamp(30px, 5vw, 56px);
  border-radius: var(--radius-xl);
}

.eyebrow {
  margin: 0 0 12px;
  color: var(--primary);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-weight: 800;
  font-size: 0.78rem;
}

h1, h2, h3, p { margin-top: 0; }

h1 {
  margin-bottom: 18px;
  max-width: 840px;
  font-size: clamp(2.4rem, 6vw, 5rem);
  line-height: 0.95;
  letter-spacing: -0.08em;
}

h2 {
  margin-bottom: 8px;
  font-size: clamp(1.5rem, 3vw, 2.15rem);
  line-height: 1.1;
  letter-spacing: -0.045em;
}

.hero-text {
  max-width: 760px;
  color: var(--muted);
  font-size: 1.1rem;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}

.button, .source-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 11px 17px;
  font-weight: 750;
  line-height: 1.2;
  transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
}

.button:hover, .source-link:hover, .chip:hover, .text-button:hover { transform: translateY(-1px); }

.button.primary {
  background: var(--primary);
  color: white;
  box-shadow: 0 12px 24px rgba(15, 118, 110, 0.2);
}

.button.ghost {
  background: var(--surface-soft);
  color: var(--text);
}

.hero-panel {
  border-radius: var(--radius-xl);
  padding: 20px;
  display: grid;
  gap: 14px;
}

.metric-card {
  padding: 22px;
  border-radius: 22px;
  background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
  border: 1px solid var(--line);
}

.metric-value {
  display: block;
  font-size: 2.3rem;
  line-height: 1;
  font-weight: 850;
  letter-spacing: -0.06em;
}

.metric-label {
  display: block;
  margin-top: 8px;
  color: var(--muted);
  font-weight: 650;
}

main { padding: 0 20px 56px; }

.controls-section {
  border-radius: var(--radius-xl);
  padding: clamp(20px, 4vw, 34px);
}

.section-heading {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: end;
  margin-bottom: 24px;
}

.updated-note {
  max-width: 420px;
  color: var(--muted);
  font-size: 0.95rem;
}

.search-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 240px;
  gap: 14px;
  margin-bottom: 16px;
}

.search-box input, select {
  width: 100%;
  border: 1px solid var(--line);
  background: white;
  border-radius: 18px;
  padding: 14px 16px;
  color: var(--text);
  outline: none;
}

.search-box input:focus, select:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 4px rgba(20, 184, 166, 0.16);
}

.filter-block {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
  margin-bottom: 18px;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.chip {
  border: 1px solid var(--line);
  background: white;
  color: var(--muted);
  border-radius: 999px;
  padding: 9px 13px;
  cursor: pointer;
  font-weight: 700;
}

.chip.active {
  background: var(--primary);
  color: white;
  border-color: var(--primary);
}

.result-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  color: var(--muted);
  font-weight: 650;
  margin: 8px 0 20px;
}

.text-button {
  border: 0;
  background: transparent;
  color: var(--primary);
  cursor: pointer;
  font-weight: 800;
}

.conference-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.conference-card {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  border: 1px solid var(--line);
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 20px;
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.05);
}

.card-top {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  align-items: flex-start;
  margin-bottom: 14px;
}

.acronym {
  font-size: 1.45rem;
  line-height: 1;
  font-weight: 850;
  letter-spacing: -0.05em;
}

.category-badge, .status-badge, .deadline-type, .tag {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  font-weight: 800;
  line-height: 1.2;
}

.category-badge {
  padding: 6px 10px;
  background: var(--surface-soft);
  color: var(--primary-dark);
  font-size: 0.78rem;
  white-space: nowrap;
}

.conference-name {
  margin-bottom: 12px;
  font-size: 1.02rem;
  line-height: 1.35;
  letter-spacing: -0.02em;
}

.meta-line {
  display: flex;
  gap: 7px;
  align-items: baseline;
  margin: 0 0 8px;
  color: var(--muted);
  font-size: 0.92rem;
}

.meta-line strong { color: var(--text); }

.deadline-list {
  margin: 16px 0;
  display: grid;
  gap: 10px;
}

.deadline-row {
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  padding: 12px;
  background: #fbfdff;
}

.deadline-row-header {
  display: flex;
  gap: 8px;
  justify-content: space-between;
  align-items: flex-start;
}

.deadline-label {
  margin: 0;
  font-weight: 800;
  line-height: 1.3;
}

.deadline-type {
  padding: 4px 8px;
  font-size: 0.72rem;
  background: var(--primary-soft);
  color: var(--primary-dark);
  text-transform: capitalize;
  white-space: nowrap;
}

.deadline-date {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 0.9rem;
}

.status-badge {
  margin-top: 8px;
  padding: 5px 9px;
  font-size: 0.76rem;
}

.status-upcoming { background: var(--primary-soft); color: var(--primary-dark); }
.status-soon { background: var(--warning-soft); color: var(--warning); }
.status-expired { background: var(--danger-soft); color: var(--danger); }
.status-tbd { background: #e0e7ff; color: #3730a3; }

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: auto;
  padding-top: 6px;
}

.tag {
  padding: 4px 8px;
  background: var(--surface-soft);
  color: var(--muted);
  font-size: 0.72rem;
}

.card-note {
  color: var(--muted);
  font-size: 0.9rem;
  margin: 8px 0 16px;
}

.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 16px;
}

.source-link {
  padding: 9px 12px;
  border: 1px solid var(--line);
  background: var(--surface-soft);
  font-size: 0.84rem;
}

.empty-state {
  margin-top: 16px;
  padding: 36px;
  border: 1px dashed var(--line);
  border-radius: var(--radius-lg);
  text-align: center;
  color: var(--muted);
}

.info-section {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-top: 22px;
}

.info-card {
  border-radius: var(--radius-lg);
  padding: 24px;
}

.info-card code {
  padding: 2px 6px;
  border-radius: 8px;
  background: var(--surface-soft);
  color: var(--primary-dark);
}

.site-footer {
  padding: 0 20px 40px;
  color: var(--muted);
  font-size: 0.92rem;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

@media (max-width: 980px) {
  .hero, .conference-grid { grid-template-columns: 1fr 1fr; }
  .hero-copy { grid-column: 1 / -1; }
  .section-heading, .result-meta { align-items: flex-start; }
}

@media (max-width: 720px) {
  .site-header { padding-top: 18px; }
  .nav-shell, .section-heading, .result-meta { flex-direction: column; }
  .nav-shell { align-items: flex-start; margin-bottom: 28px; }
  .hero, .conference-grid, .info-section, .search-row { grid-template-columns: 1fr; }
  .hero-panel { grid-template-columns: 1fr; }
  h1 { font-size: clamp(2.25rem, 14vw, 4rem); }
}
